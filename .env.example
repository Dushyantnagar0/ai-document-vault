# Validated local Compose defaults; see docs/HANDOFF.md for verification and limits.
# Copy to ignored .env for local use. Only the OpenAI key needs external input.
# Units: bytes, tokens and seconds unless named otherwise. Never commit real keys.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini-2026-03-17
# Factual source selection/composition only; reviewed alias with fixed low reasoning.
OPENAI_SOURCE_ANSWER_MODEL=gpt-6.1-sol
# Final analysis review only; reviewed alias with fixed low reasoning.
# Planner, legacy answers/review, analysis writing and insights keep OPENAI_CHAT_MODEL.
OPENAI_ANALYSIS_REVIEW_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match stored profile AND migrated vector dimensions; not a free runtime switch.
OPENAI_EMBEDDING_DIMENSIONS=1536

# Local-only defaults, not production credentials. Settings construct the DB URL.
POSTGRES_DB=document_vault
POSTGRES_USER=document_vault
POSTGRES_PASSWORD=local_development_only
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
VECTOR_BACKEND=pgvector
LOCAL_STORAGE_DIR=/app/data/uploads
# Host ports only; internal API/UI ports remain 8000/8501.
API_PORT=4000
UI_PORT=4005

# Optional input/extraction tuning. Exceeding limits fails visibly, never truncates.
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500
MAX_DOCX_EXPANDED_BYTES=104857600
MAX_DOCX_ENTRIES=2000
MAX_EXTRACTED_TEXT_BYTES=2097152
MAX_EXTRACTED_TOKENS=100000
MAX_DOCUMENT_CHUNKS=500

# Indexing changes need compatible profile/reindexing; overlap must be less than size.
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_MAX_TOKENS=32000

# Analysis budgets include reserved prompt/output space and bounded reduction.
ANALYSIS_GROUP_MAX_TOKENS=12000
ANALYSIS_MAX_OUTPUT_TOKENS=768
SUMMARY_MAX_OUTPUT_TOKENS=1500
# Total completion budgets include reasoning; visible insight content has its own cap.
EVIDENCE_REVIEW_MAX_OUTPUT_TOKENS=4096
INSIGHT_MAX_OUTPUT_TOKENS=3072
INSIGHT_MAX_VISIBLE_TOKENS=600
# Focused insights and legacy chat review; final analysis review stays fixed low.
OPENAI_REVIEW_REASONING_EFFORT=low
# Across all ingestion attempts, including failed/repair calls.
MAX_DOCUMENT_AI_CALLS=64

# Optional chat tuning, jointly validated against the model context capacity.
PLANNER_MAX_OUTPUT_TOKENS=256
QUESTION_MAX_CHARS=4000
QUESTION_MAX_TOKENS=1000
CHAT_HISTORY_MAX_TURNS=4
CHAT_HISTORY_MAX_TOKENS=2000
RETRIEVAL_CANDIDATES=16
RETRIEVAL_MAX_CHUNKS=8
RETRIEVAL_MAX_TOKENS=6400
CHAT_PROMPT_MAX_TOKENS=12000
CHAT_MAX_OUTPUT_TOKENS=1200
# Answer drafting only; the completion cap includes reasoning. Planner remains none.
OPENAI_ANSWER_REASONING_EFFORT=low

# Bounded execution; provider quota belongs to the account, not these settings.
OPENAI_EMBEDDING_TIMEOUT_SECONDS=15
OPENAI_GENERATION_TIMEOUT_SECONDS=30
CHAT_TIMEOUT_SECONDS=90
CELERY_WORKER_CONCURRENCY=2
API_MAX_CONCURRENT_AI_REQUESTS=2
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_DEADLINE_SECONDS=1800
